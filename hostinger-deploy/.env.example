# ============================================================
# AI Academy 2.0 — Environment Variables for Hostinger
# ============================================================
# Copy this file to .env and fill in your actual values.
# Set these in Hostinger's Node.js panel → Environment Variables.
# ============================================================

# ── Server ────────────────────────────────────────────────
# Hostinger sets PORT automatically — do NOT override unless instructed
# PORT=3000

# Must be "production" on Hostinger
NODE_ENV=production

# Path to the built frontend (relative to the deploy directory)
# Leave as "public" — the build script puts the frontend here
STATIC_PATH=public

# ── Supabase ──────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project Settings → API

# Your Supabase project URL (e.g. https://xxxxxxxxxxxx.supabase.co)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Service Role key — keep SECRET, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Anon / public key (used if frontend calls Supabase directly)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Authentication ────────────────────────────────────────
# Any long random string — used to sign JWT tokens.
# Generate one at: https://generate-secret.vercel.app/64
SESSION_SECRET=replace_with_a_long_random_secret_string_here

# ── WhatsApp support link ─────────────────────────────────
# Phone number shown on the "Contact Admin" button (international format, no +)
# WHATSAPP_NUMBER=923278035433

# ── Email (optional — powered by Resend) ─────────────────
# Sign up at https://resend.com and get your API key
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=noreply@yourdomain.com
