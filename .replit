modules = ["nodejs-24", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
JWT_SECRET = "lms-jwt-secret-dev-key-change-in-production"

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 6800

[[ports]]
localPort = 8083
externalPort = 5173

[[ports]]
localPort = 8087
externalPort = 6000

[[ports]]
localPort = 8089
externalPort = 8008

[[ports]]
localPort = 22419
externalPort = 3002

[[ports]]
localPort = 22420
externalPort = 4200

[[ports]]
localPort = 22421
externalPort = 3003

[[ports]]
localPort = 22422
externalPort = 5000

[[ports]]
localPort = 22423
externalPort = 8099

[[ports]]
localPort = 22424
externalPort = 3001

[[ports]]
localPort = 22426
externalPort = 9000

[[ports]]
localPort = 22428
externalPort = 8000

[[ports]]
localPort = 22429
externalPort = 80

[[ports]]
localPort = 22430
externalPort = 3000
