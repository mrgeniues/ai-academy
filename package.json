{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "echo done",
    "start": "node --enable-source-maps artifacts/api-server/dist/index.mjs",
    "build:prod": "BASE_PATH=/ pnpm --filter @workspace/lms run build && pnpm --filter @workspace/api-server run build",
    "start:prod": "NODE_ENV=production pnpm --filter @workspace/api-server run start",
    "start": "node --enable-source-maps ./artifacts/api-server/dist/index.mjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": ["@swc/core", "esbuild", "msw", "unrs-resolver"],
    "allowedScripts": ["prepare", "postinstall", "build", "esbuild", "preinstall"]
  },
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.1"
  }
}
